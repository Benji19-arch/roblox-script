local title=Instance.new("TextLabel"); title.Size=UDim2.new(1,-48,0,44); title.Position=UDim2.fromOffset(12,0); title.BackgroundTransparency=1; title.Text="R1 / Rapport pret - clique le texte, Ctrl+A puis Ctrl+C"; title.TextColor3=Color3.new(1,1,1); title.TextSize=13; title.TextXAlignment=Enum.TextXAlignment.Left; title.Parent=panel
local close=Instance.new("TextButton"); close.Position=UDim2.new(1,-36,0,8); close.Size=UDim2.fromOffset(28,28); close.Text="X"; close.Parent=panel
local scroll=Instance.new("ScrollingFrame"); scroll.Position=UDim2.fromOffset(12,48); scroll.Size=UDim2.new(1,-24,1,-60); scroll.BackgroundColor3=Color3.fromRGB(30,30,36); scroll.BorderSizePixel=0; scroll.ScrollBarThickness=4; scroll.AutomaticCanvasSize=Enum.AutomaticSize.Y; scroll.CanvasSize=UDim2.new(); scroll.Parent=panel
local box=Instance.new("TextBox"); box.Name="Report"; box.Size=UDim2.new(1,-12,0,0); box.Position=UDim2.fromOffset(6,6); box.AutomaticSize=Enum.AutomaticSize.Y; box.BackgroundTransparency=1; box.MultiLine=true; box.ClearTextOnFocus=false; box.TextWrapped=true; box.TextXAlignment=Enum.TextXAlignment.Left; box.TextYAlignment=Enum.TextYAlignment.Top; box.Font=Enum.Font.Code; box.TextSize=12; box.TextColor3=Color3.fromRGB(230,230,240); box.Text=json; box.Parent=scroll
close.Activated:Connect(function() gui:Destroy() end)
gui.Parent=pg
