local function setting(page,key,title,values,suffix)
 local row=make("Frame",pages[page],{Size=UDim2.new(1,0,0,42),BackgroundColor3=card,BorderSizePixel=0}); round(row)
 label(row,title,UDim2.fromOffset(10,0),UDim2.new(1,-150,1,0))
 local b=make("TextButton",row,{Position=UDim2.new(1,-138,0,6),Size=UDim2.fromOffset(128,30),BackgroundColor3=bg,TextColor3=accent,TextSize=12,Font=Enum.Font.GothamBold,BorderSizePixel=0}); round(b)
 local function refresh()
  local v=config[key]
  if typeof(v)=="boolean" then b.Text=v and "ACTIVE" or "DESACTIVE"
  else b.Text=tostring(v)..(suffix or "") end
  b.TextColor3=v==false and Color3.fromRGB(150,160,180) or accent
 end
 table.insert(refreshers,refresh)
 connect(b.Activated,function()
  if values then config[key]=values[((table.find(values,config[key]) or 0)%#values)+1]
  else config[key]=not config[key] end
  locked=nil; refresh()
 end)
 refresh()
end
