end
local function planAim(dt)
 if stopped then return end
 updateLocalCharacter()
 local camera=workspace.CurrentCamera
 aiming=aimRequested()
 if not camera or not aiming or not localHumanoid or localHumanoid.Health<=0
  or not localRoot or not localRoot:IsDescendantOf(workspace) then
  locked=nil; aimClock=AIM_INTERVAL; aimBlocked=false; blockedSince=nil
  releaseCamera(); return
 end
 aimClock+=dt
 -- Liberer une cible morte, hors portee ou retiree sans attendre le prochain scan.
 if locked and not valid(locked) then locked=nil; aimClock=AIM_INTERVAL end
 if aimClock>=AIM_INTERVAL then aimClock=0; acquire(camera) end
 if not valid(locked) then locked=nil; releaseCamera(); return end
 local control=ensureCamera(camera)
 local pivot=characterPivot()
 local origin=control.centered and pivot or camera.CFrame.Position
 local targetPosition=locked.aimPart.Position
 local desired=aimRotation(origin,targetPosition,lastAimRotation or camera.CFrame.Rotation)
 if not desired then releaseCamera(); return end
 if lastAimRecord~=locked then lastAimRotation=camera.CFrame.Rotation; lastAimRecord=locked end
 if not aimBlocked then
  if config.Tracking=="Direct" then lastAimRotation=desired
  else lastAimRotation=lastAimRotation:Lerp(desired,1-math.exp(-config.Smooth*math.max(dt,0))) end
 end
 local position=control.centered and collisionSafe(camera,pivot,pivot-lastAimRotation.LookVector*config.AimDistance) or origin
 aimPlan=aimPlan or {}
 aimPlan.camera=camera; aimPlan.control=control; aimPlan.record=locked
 aimPlan.frame=CFrame.new(position)*lastAimRotation
 aimPlan.focus=control.centered and CFrame.new(pivot) or camera.Focus
 aimPlan.target=targetPosition
 camera.CFrame=aimPlan.frame
 if control.centered then camera.Focus=aimPlan.focus end
end
