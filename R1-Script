local function releaseVisuals(r)
 if r.highlight then r.highlight:Destroy(); r.highlight=nil end
 if r.info then r.info:Destroy(); r.info=nil; r.text=nil end
 if r.skeleton then r.skeleton:Destroy(); r.skeleton=nil; r.bones=nil end
 r.rig=nil
end
-- Masquage local des noms Roblox des PNJ, restaure au nettoyage.
local function hideBotName(r,hide)
 local h=r.humanoid
 if hide then
  if r.previousDisplayType==nil then
   r.previousDisplayType=h.DisplayDistanceType
   h.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
  end
 elseif r.previousDisplayType~=nil then
  if h.Parent and h.DisplayDistanceType==Enum.HumanoidDisplayDistanceType.None then
   h.DisplayDistanceType=r.previousDisplayType
  end
  r.previousDisplayType=nil
 end
end
local function remove(model)
 local r=records[model]
 if not r then return end
 hideBotName(r,false)
 releaseVisuals(r)
 activeRecords[r]=nil
 records[model]=nil
 if locked==r then locked=nil end
end
local function add(h)
 if stopped or not h:IsA("Humanoid") then return end
 local model=h.Parent
 if not model or not model:IsA("Model") or not model:IsDescendantOf(workspace) then return end
 local oldRecord=records[model]
 if oldRecord and oldRecord.humanoid==h then return end
 if oldRecord then remove(model) end
 records[model]={model=model,humanoid=h,inSight=false}
end
connect(workspace.DescendantAdded,function(obj)
 if obj:IsA("Humanoid") then task.defer(add,obj) end
end)
connect(workspace.DescendantRemoving,function(obj)
 if obj:IsA("Humanoid") and obj.Parent then
  local r=records[obj.Parent]
  if r and r.humanoid==obj then remove(obj.Parent) end
 end
end)
