local function releaseCamera()
 local control=cameraControl
 cameraControl=nil; aimPlan=nil
 if control then
  releaseBody(control)
  if control.ownsCamera and control.camera.Parent and control.camera.CameraType==Enum.CameraType.Scriptable then
   control.camera.CameraType=control.originalType
