local rayParams=RaycastParams.new()
rayParams.FilterType=Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater=true
local rayIgnored={}
local function clearTo(camera,model,position)
 local origin=camera.CFrame.Position
 local direction=position-origin
 if direction.Magnitude<0.001 then return true end
 table.clear(rayIgnored)
 if localCharacter then table.insert(rayIgnored,localCharacter) end
 -- Les bras et l'arme de premiere personne ne doivent pas bloquer la visee.
 table.insert(rayIgnored,camera)
 for _=1,6 do
  rayParams.FilterDescendantsInstances=rayIgnored
  local hit=workspace:Raycast(origin,direction,rayParams)
  if not hit or hit.Instance:IsDescendantOf(model) then return true end
  if hit.Instance:IsA("BasePart") and hit.Instance.Transparency>=0.95 then
   table.insert(rayIgnored,hit.Instance)
  else return false end
 end
 return false
end
local function partOf(model,name)
 local part=model:FindFirstChild(name)
 return part and part:IsA("BasePart") and part or nil
end
local function updateLocalCharacter()
 localCharacter=player.Character
 localHumanoid=localCharacter and localCharacter:FindFirstChildOfClass("Humanoid")
 localRoot=localCharacter and (partOf(localCharacter,"HumanoidRootPart") or localCharacter.PrimaryPart)
 if localRoot and not localRoot:IsA("BasePart") then localRoot=nil end
end
local function isAllied(model,owner)
 if not config.TeamCheck then return false end
 if owner then return not player.Neutral and not owner.Neutral and player.Team~=nil and player.Team==owner.Team end
 return model:GetAttribute("Friendly")==true
  or (not player.Neutral and player.Team~=nil and model:GetAttribute("TeamName")==player.Team.Name)
end
local function valid(r)
 if not r or records[r.model]~=r or r.model==player.Character then return false end
 if r.humanoid.Parent~=r.model or r.humanoid.Health<=0 or not r.model:IsDescendantOf(workspace) then return false end
 if not localRoot or not localRoot:IsDescendantOf(workspace) then return false end
 local owner=Players:GetPlayerFromCharacter(r.model)
 local bot=owner==nil
 if owner==player or (bot and not config.Bots) or (not bot and not config.TargetPlayers) or isAllied(r.model,owner) then return false end
 -- Relire la vraie piece : une tete remplacee ou retiree ne laisse pas une reference perimee.
 local part=partOf(r.model,config.Part)
 if not part or not part:IsDescendantOf(workspace) then return false end
 local root=partOf(r.model,"HumanoidRootPart") or part
 local distance=(root.Position-localRoot.Position).Magnitude
 if distance>config.Range then return false end
 r.aimPart=part; r.owner=owner; r.bot=bot; r.distance=distance
 return true
end
local function screenScore(camera,r)
 if not valid(r) then return nil end
 local p,onScreen=camera:WorldToViewportPoint(r.aimPart.Position)
 if not onScreen or p.Z<=0 then return nil end
 local delta=(Vector2.new(p.X,p.Y)-camera.ViewportSize/2).Magnitude
 return delta<=config.Fov and delta or nil
end
local function allocateVisuals(r)
 if r.highlight then return end
 r.highlight=make("Highlight",gui,{Adornee=r.model,Enabled=false,FillTransparency=1,
