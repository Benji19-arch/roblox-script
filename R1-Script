local function remove(model)
 local r=records[model]; if not r then return end
 r.highlight:Destroy(); r.info:Destroy(); r.skeleton:Destroy(); records[model]=nil
 if locked==model then locked=nil end
end
local function add(obj)
 if stopped or not obj:IsA("Humanoid") then return end
 local model=obj.Parent
 if not model or not model:IsA("Model") or records[model] or not model:IsDescendantOf(workspace) then return end
 local h=make("Highlight",gui,{Adornee=model,Enabled=false,FillTransparency=1,OutlineTransparency=0,DepthMode=Enum.HighlightDepthMode.AlwaysOnTop})
 local info=make("BillboardGui",gui,{Size=UDim2.fromOffset(230,64),StudsOffsetWorldSpace=Vector3.new(0,3,0),AlwaysOnTop=true,Enabled=false})
 local t=label(info,"",UDim2.new(),UDim2.fromScale(1,1)); t.TextXAlignment=Enum.TextXAlignment.Center; t.TextStrokeTransparency=.25
 local skeleton=make("Frame",gui,{Name="Skeleton",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Visible=false,ZIndex=0})
 local bones={}
 for i=1,15 do
  bones[i]=make("Frame",skeleton,{Name="Bone"..i,AnchorPoint=Vector2.new(.5,.5),BorderSizePixel=0,BackgroundColor3=accent,Visible=false,Active=false})
 end
 records[model]={humanoid=obj,highlight=h,info=info,text=t,lastCheck=0,inSight=false,skeleton=skeleton,bones=bones}
end
connect(workspace.DescendantAdded,function(obj) if obj:IsA("Humanoid") then task.defer(add,obj) end end)
for _,obj in workspace:GetDescendants() do if obj:IsA("Humanoid") then add(obj) end end
