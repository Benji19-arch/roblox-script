local function characterPivot()
 return localRoot.Position+Vector3.new(0,localRoot.Size.Y*.75,0)
end
local function collisionSafe(camera,pivot,position)
 local direction=position-pivot
 if direction.Magnitude<=.5 then return position end
 table.clear(collisionFilter)
 table.insert(collisionFilter,localCharacter); table.insert(collisionFilter,camera)
 collisionParams.FilterDescendantsInstances=collisionFilter
 local hit=workspace:Raycast(pivot,direction,collisionParams)
 if hit then return pivot+direction.Unit*math.max(.05,hit.Distance-.25) end
