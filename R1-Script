local rayParams=RaycastParams.new()
rayParams.FilterType=Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater=true
local rayIgnored={}
local function clearTo(camera,model,position)
 local origin=camera.CFrame.Position
 local direction=position-origin
 if direction.Magnitude<0.001 then return true end
 table.clear(rayIgnored)
 if localCharacter then table.insert(rayIgnored,localCharacter) end
 -- Les bras et l'arme de premiere personne ne doivent pas bloquer la visee.
 table.insert(rayIgnored,camera)
 for _=1,6 do
  rayParams.FilterDescendantsInstances=rayIgnored
  local hit=workspace:Raycast(origin,direction,rayParams)
  if not hit or hit.Instance:IsDescendantOf(model) then return true end
  if hit.Instance:IsA("BasePart") and hit.Instance.Transparency>=0.95 then
   table.insert(rayIgnored,hit.Instance)
  else return false end
 end
 return false
end
local function partOf(model,name)
 local part=model:FindFirstChild(name)
 return part and part:IsA("BasePart") and part or nil
end
local function valid(r)
 return r and records[r.model]==r and r.eligible and r.humanoid.Health>0
  and r.aimPart and r.aimPart:IsDescendantOf(workspace)
end
local function screenScore(camera,r)
 if not valid(r) then return nil end
 local p,onScreen=camera:WorldToViewportPoint(r.aimPart.Position)
 if not onScreen or p.Z<=0 then return nil end
 local delta=(Vector2.new(p.X,p.Y)-camera.ViewportSize/2).Magnitude
 return delta<=config.Fov and delta or nil
end
local function allocateVisuals(r)
 if r.highlight then return end
 r.highlight=make("Highlight",gui,{Adornee=r.model,Enabled=false,FillTransparency=1,
  OutlineTransparency=0,DepthMode=Enum.HighlightDepthMode.AlwaysOnTop})
 r.info=make("BillboardGui",gui,{Size=UDim2.fromOffset(230,78),StudsOffsetWorldSpace=Vector3.new(0,3,0),AlwaysOnTop=true,Enabled=false})
 r.text=label(r.info,"",UDim2.new(),UDim2.fromScale(1,1))
 r.text.TextXAlignment=Enum.TextXAlignment.Center; r.text.TextStrokeTransparency=.25
end
local r15Bones={
 {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
 {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
 {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
 {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
 {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
}
local r15Points={UpperTorso="NeckRigAttachment",LowerTorso="WaistRigAttachment",
 LeftUpperArm="LeftShoulderRigAttachment",LeftLowerArm="LeftElbowRigAttachment",LeftHand="LeftWristRigAttachment",
 RightUpperArm="RightShoulderRigAttachment",RightLowerArm="RightElbowRigAttachment",RightHand="RightWristRigAttachment",
 LeftUpperLeg="LeftHipRigAttachment",LeftLowerLeg="LeftKneeRigAttachment",LeftFoot="LeftAnkleRigAttachment",
 RightUpperLeg="RightHipRigAttachment",RightLowerLeg="RightKneeRigAttachment",RightFoot="RightAnkleRigAttachment"}
local function rigPoint(part,attachmentName,offset)
 local attachment=attachmentName and part:FindFirstChild(attachmentName)
 return {part=part,attachment=attachment and attachment:IsA("Attachment") and attachment or nil,offset=offset or Vector3.zero}
end
local function worldPoint(ref)
 if not ref.part:IsDescendantOf(workspace) then return nil end
 if ref.attachment and ref.attachment.Parent then return ref.attachment.WorldPosition end
 return ref.part.CFrame:PointToWorldSpace(ref.offset)
end
local function allocateSkeleton(r)
 if r.skeleton then return end
 local rig={}
 local function segment(a,b) table.insert(rig,{a,b}) end
 if partOf(r.model,"UpperTorso") then
  for _,pair in r15Bones do
   local a,b=partOf(r.model,pair[1]),partOf(r.model,pair[2])
   if a and b then segment(rigPoint(a,r15Points[pair[1]]),rigPoint(b,r15Points[pair[2]])) end
  end
 else
  local torso=partOf(r.model,"Torso")
  if torso then
   local function torsoPoint(x,y) return rigPoint(torso,nil,Vector3.new(x*torso.Size.X,y*torso.Size.Y,0)) end
   local top,bottom=torsoPoint(0,.4),torsoPoint(0,-.4)
   segment(top,bottom)
   local head=partOf(r.model,"Head")
   if head then segment(rigPoint(head),top) end
   for _,limb in {{"Left Arm",-.5,.4,top},{"Right Arm",.5,.4,top},{"Left Leg",-.25,-.4,bottom},{"Right Leg",.25,-.4,bottom}} do
    local part=partOf(r.model,limb[1])
    if part then
     local joint=torsoPoint(limb[2],limb[3])
     segment(limb[4],joint)
     segment(joint,rigPoint(part,nil,Vector3.new(0,-part.Size.Y*.45,0)))
    end
   end
  end
 end
 r.rig=rig; r.bones={}
 r.skeleton=make("Frame",gui,{Name="Skeleton",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,Visible=false,ZIndex=0})
 for i=1,#rig do
  r.bones[i]=make("Frame",r.skeleton,{AnchorPoint=Vector2.new(.5,.5),BorderSizePixel=0,Visible=false,Active=false})
 end
end
local function updateSkeleton(camera,r)
 if not config.Skeleton then if r.skeleton then r.skeleton.Visible=false end; return end
 allocateSkeleton(r)
 r.skeleton.Visible=true
 for i,line in r.bones do
  local bone=r.rig[i]
  local a,b=worldPoint(bone[1]),worldPoint(bone[2])
  line.Visible=false
  if a and b then
   local pa,sa=camera:WorldToViewportPoint(a)
   local pb,sb=camera:WorldToViewportPoint(b)
   if sa and sb and pa.Z>0 and pb.Z>0 then
    local first,second=Vector2.new(pa.X,pa.Y),Vector2.new(pb.X,pb.Y)
    local delta=second-first
    if delta.Magnitude>.5 then
     local midpoint=(first+second)/2
     line.Position=UDim2.fromOffset(midpoint.X,midpoint.Y)
     line.Size=UDim2.fromOffset(delta.Magnitude,2)
     line.Rotation=math.deg(math.atan2(delta.Y,delta.X))
     line.BackgroundColor3=r.inSight and visibleColor or hiddenColor
     line.Visible=true
    end
   end
  end
 end
end
local function scan(camera)
 localCharacter=player.Character
 localRoot=localCharacter and (partOf(localCharacter,"HumanoidRootPart") or localCharacter.PrimaryPart or partOf(localCharacter,"Head"))
 localHumanoid=localCharacter and localCharacter:FindFirstChildOfClass("Humanoid")
 table.clear(aimCandidates); table.clear(displayList); table.clear(registryList)
 for model,r in records do
  if not model:IsDescendantOf(workspace) or r.humanoid.Parent~=model then remove(model); continue end
  r.eligible=false
  local owner=Players:GetPlayerFromCharacter(model)
  hideBotName(r,model~=localCharacter and owner==nil)
  if model==localCharacter or not localRoot or r.humanoid.Health<=0 then continue end
  if owner==player then continue end
  local bot=owner==nil
  if (bot and not config.Bots) or (not bot and not config.TargetPlayers) then continue end
  local allied=false
  if config.TeamCheck then
   if owner then allied=not player.Neutral and not owner.Neutral and player.Team~=nil and player.Team==owner.Team
   else allied=model:GetAttribute("Friendly")==true or (not player.Neutral and player.Team~=nil and model:GetAttribute("TeamName")==player.Team.Name) end
  end
  if allied then continue end
  local root=partOf(model,"HumanoidRootPart") or model.PrimaryPart
  local part=partOf(model,config.Part) or root or partOf(model,"Head")
  if not part or not part:IsA("BasePart") then continue end
  local distance=((root or part).Position-localRoot.Position).Magnitude
  if distance>config.Range then continue end
  r.owner=owner; r.bot=bot; r.distance=distance; r.displayPart=part; r.eligible=true
  -- En mode Head, ne jamais remplacer silencieusement la tete par le torse.
  r.aimPart=partOf(model,config.Part)
  r.head=partOf(model,"Head"); r.torso=partOf(model,"UpperTorso") or partOf(model,"Torso"); r.root=root
  table.insert(aimCandidates,r)
  if config.ESP then
   local p,onScreen=camera:WorldToViewportPoint(part.Position)
   if onScreen and p.Z>0 then table.insert(displayList,r) end
  end
 end
 table.sort(displayList,function(a,b) return a.distance<b.distance end)
 local selected={}
 for i=1,math.min(config.MaxESP,#displayList) do selected[displayList[i]]=true end
 for r in activeRecords do
  if not selected[r] then releaseVisuals(r); activeRecords[r]=nil end
 end
 for r in selected do allocateVisuals(r); activeRecords[r]=true; table.insert(registryList,r) end
 -- Budget fixe : 4 personnages, 3 points maximum chacun par mise a jour.
 local checks=math.min(VISIBILITY_BUDGET,#registryList)
 for _=1,checks do
  visibilityCursor=visibilityCursor%#registryList+1
  local r=registryList[visibilityCursor]
  local inSight=false
  for _,part in {r.head or r.displayPart,r.torso or r.displayPart,r.root or r.displayPart} do
   local p,onScreen=camera:WorldToViewportPoint(part.Position)
   if onScreen and p.Z>0 and clearTo(camera,r.model,part.Position) then inSight=true; break end
  end
  r.inSight=inSight
 end
 for r in activeRecords do
  local color=r.inSight and visibleColor or hiddenColor
  r.highlight.Enabled=config.Outline
  r.highlight.OutlineColor=color
  r.info.Adornee=r.head or r.displayPart
  r.info.Enabled=config.Names or config.Health or config.Distance
  if r.info.Enabled then
   local lines={}
   if config.Names then
    if not r.bot and r.owner then table.insert(lines,"[JOUEUR] "..r.owner.DisplayName) end
    table.insert(lines,r.inSight and "VISIBLE" or "CACHE")
   end
   if config.Health then table.insert(lines,string.format("Vie : %.0f / %.0f",r.humanoid.Health,r.humanoid.MaxHealth)) end
   if config.Distance then table.insert(lines,string.format("%.0f studs",r.distance)) end
   local value=table.concat(lines,"\n")
   if r.text.Text~=value then r.text.Text=value end
   r.text.TextColor3=color
  end
  if not config.Skeleton and r.skeleton then r.skeleton.Visible=false end
 end
end
local shortlist={}
local blockedSince,aimBlocked=nil,false
local lastAimRotation,lastAimRecord,lastAimCamera=nil,nil,nil
local function acquire(camera)
 -- Le rayon sert a choisir une cible, pas a changer de personnage pendant le suivi.
 if config.Sticky and valid(locked) then
  if not config.WallCheck or clearTo(camera,locked.model,locked.aimPart.Position) then
   blockedSince=nil; aimBlocked=false; return
  end
  -- Un obstacle tres bref ne provoque pas un saut vers une autre tete.
  blockedSince=blockedSince or os.clock()
  aimBlocked=true
  if os.clock()-blockedSince<0.18 then return end
 end
 locked=nil; blockedSince=nil; aimBlocked=false
 table.clear(shortlist)
 for _,r in aimCandidates do
  local score=screenScore(camera,r)
  if score then
   r.score=score
   local index=#shortlist+1
   for i,other in shortlist do if score<other.score then index=i; break end end
   if index<=6 then
    table.insert(shortlist,index,r)
    if #shortlist>6 then table.remove(shortlist) end
   end
  end
 end
 for _,r in shortlist do
  if not config.WallCheck or clearTo(camera,r.model,r.aimPart.Position) then locked=r; break end
 end
 selectionMessage=#shortlist==0 and "Aucune cible dans le rayon / verifie Cibles" or "Cible bloquee par un obstacle"
end
local function setStatus(value) if status.Text~=value then status.Text=value end end
connect(RunService.Heartbeat,function(dt)
 if stopped then return end
 scanClock+=dt
 if scanClock<SCAN_INTERVAL then return end
 scanClock=0
 local camera=workspace.CurrentCamera
 if not camera then return end
 scan(camera)
 local viewport=camera.ViewportSize
 local wantedScale=math.max(.1,math.min(1,(viewport.X-36)/500,(viewport.Y-82)/470))
 if scale.Scale~=wantedScale then scale.Scale=wantedScale end
 circle.Size=UDim2.fromOffset(config.Fov*2,config.Fov*2)
 circle.Position=UDim2.fromOffset(viewport.X/2,viewport.Y/2)
 circle.Visible=config.Circle and config.Aim
 if not config.Aim then setStatus("Visee desactivee")
 elseif not localHumanoid or localHumanoid.Health<=0 then setStatus("En attente de ton personnage vivant")
 elseif Input:GetFocusedTextBox() then setStatus("Ferme la saisie de texte pour viser")
 elseif not aiming then setStatus("Maintiens le clic droit / mode "..config.Activation)
 elseif locked then
  local targetName=locked.bot and "PNJ" or (locked.owner and locked.owner.DisplayName or "Joueur")
  setStatus((aimBlocked and "Obstacle bref : " or "Cible : ")..targetName)
 else setStatus(selectionMessage) end
 stroke.Color=locked and visibleColor or accent
end)
RunService:BindToRenderStep(binding,Enum.RenderPriority.Last.Value,function(dt)
 if stopped then return end
 local camera=workspace.CurrentCamera
 if not camera then return end
 -- Lecture directe : le clic droit reste detecte meme s'il est consomme par la camera Roblox.
 aiming=focused and config.Aim and not Input:GetFocusedTextBox()
  and (config.Activation=="Permanent" or rightHeld or Input:IsMouseButtonPressed(Enum.UserInputType.MouseButton2))
 local canAim=aiming and localHumanoid and localHumanoid.Health>0
 aimClock+=dt
 if canAim then
  if aimClock>=AIM_INTERVAL then aimClock=0; acquire(camera) end
  if valid(locked) then
   local position=camera.CFrame.Position
   local targetPosition=locked.aimPart.Position
   if (targetPosition-position).Magnitude>.001 then
    local desired=CFrame.lookAt(position,targetPosition).Rotation
    if lastAimRecord~=locked or lastAimCamera~=camera then
     lastAimRotation=camera.CFrame.Rotation
     lastAimRecord=locked; lastAimCamera=camera
    end
    if not aimBlocked then
     if config.Tracking=="Direct" then
      -- La tete est suivie a chaque image, sans retard de lissage.
      lastAimRotation=desired
     else
      -- Partir de notre derniere rotation, pas de celle reinitialisee par la camera Roblox.
      lastAimRotation=lastAimRotation:Lerp(desired,1-math.exp(-config.Smooth*math.min(dt,0.1)))
      if lastAimRotation.LookVector:Dot(desired.LookVector)>0.999998 then lastAimRotation=desired end
     end
    end
    -- Pendant une obstruction breve, conserver la direction sans suivre a travers le mur.
    camera.CFrame=CFrame.new(position)*lastAimRotation
   end
  else
   locked=nil; lastAimRotation=nil; lastAimRecord=nil
  end
 else
  locked=nil; aimClock=AIM_INTERVAL; aimBlocked=false; blockedSince=nil
  lastAimRotation=nil; lastAimRecord=nil; lastAimCamera=nil
 end
 boneClock+=dt
 if boneClock>=1/config.SkeletonFPS then
  boneClock=0
  for r in activeRecords do updateSkeleton(camera,r) end
 end
end)
local function cleanup()
 if stopped then return end
 stopped=true; RunService:UnbindFromRenderStep(binding)
 for _,c in connections do c:Disconnect() end
 for model in records do remove(model) end
 gui:Destroy()
end
connect(shutdown.Event,cleanup)
connect(script.Destroying,cleanup)
connect(gui.Destroying,cleanup)
