end
local function ensureCamera(camera)
 local control=cameraControl
 if control and (control.camera~=camera or control.root~=localRoot or control.humanoid~=localHumanoid or control.centered~=config.CenterCharacter) then
  releaseCamera(); control=nil
 end
 if not control then
  control={camera=camera,root=localRoot,humanoid=localHumanoid,centered=config.CenterCharacter,
   originalType=camera.CameraType,originalFocus=camera.Focus,
   originalAutoRotate=localHumanoid.AutoRotate,bodyOwned=false,ownsCamera=config.CenterCharacter}
  cameraControl=control
 end
 if control.ownsCamera then camera.CameraType=Enum.CameraType.Scriptable end
 return control
end
local function aimRotation(origin,target,previous)
 local direction=target-origin
 if direction.Magnitude<.001 then return nil end
 local forward=direction.Unit
 local right
 if math.abs(forward.Y)>.995 then
  -- A la verticale, conserver un repere stable au lieu de retourner la camera.
  local previousRight=previous.RightVector
  right=previousRight-forward*previousRight:Dot(forward)
  if right.Magnitude<.001 then
   local axis=math.abs(forward.X)<.9 and Vector3.xAxis or Vector3.zAxis
   right=axis-forward*axis:Dot(forward)
  end
 else
  right=forward:Cross(Vector3.yAxis)
 end
 right=right.Unit
 return CFrame.fromMatrix(Vector3.zero,right,right:Cross(forward).Unit,-forward)
end
local function aimRequested()
 return focused and config.Aim and not Input:GetFocusedTextBox()
  and (config.Activation=="Permanent" or Input:IsMouseButtonPressed(Enum.UserInputType.MouseButton2))
