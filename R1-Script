    gameAim.responseX,gameAim.candidateX=learnResponse(gameAim.responseX,gameAim.candidateX,changeX/delta.X)
   end
   if math.abs(delta.Y)>=1 and math.abs(changeY)<.35 and math.abs(rotation.LookVector.Y)<.95 then
    gameAim.responseY,gameAim.candidateY=learnResponse(gameAim.responseY,gameAim.candidateY,changeY/delta.Y)
   end
  end
 end
 gameAim.rotation=rotation
 if gameAim.watch then
  local movement=(gameAim.watch:ToObjectSpace(rotation).LookVector-Vector3.new(0,0,-1)).Magnitude
  if movement>.00001 then gameAim.watch=nil; gameAim.watchClock=0
  else
   gameAim.watchClock+=dt
   if gameAim.watchClock>.75 then
    gameInputError="Le jeu ne reagit pas aux entrees : relache puis reprends le clic droit"
    resetGameAim(); gameAimMessage=gameInputError; return
   end
  end
 end
 local error=Vector2.new(point.X,point.Y)-camera.ViewportSize/2
 local focal=camera.ViewportSize.Y/(2*math.tan(math.rad(camera.FieldOfView)/2))
 local deadX=relativeInput and math.max(.35,math.abs(gameAim.responseX or 0)*focal*.5) or .35
 local deadY=relativeInput and math.max(.35,math.abs(gameAim.responseY or 0)*focal*.5) or .35
 gameAimMessage=string.format("Mode Jeu / ecart ecran : %.1f px",error.Magnitude)
 local insideX,insideY=math.abs(error.X)<=deadX,math.abs(error.Y)<=deadY
 if insideX and not gameAim.insideX then gameAim.carryX=0 end
 if insideY and not gameAim.insideY then gameAim.carryY=0 end
 gameAim.insideX=insideX; gameAim.insideY=insideY
 local moving=(math.abs(gameAim.advanceX)+math.abs(gameAim.advanceY))*focal>.01
 if insideX and insideY and not moving then
  gameAim.clock=0; gameAim.carryX=0; gameAim.carryY=0; gameAim.advanceX=0; gameAim.advanceY=0
  gameAim.watch=nil; gameAim.watchClock=0; gameAim.previousError=nil; return
 end
 gameAim.clock+=dt
 if gameAim.clock<1/120 then return end
 local elapsed=math.min(gameAim.clock,.05); gameAim.clock=0
 if gameAim.previousError then
  local previous=gameAim.previousError
  local flipX=error.X*previous.X<0 and math.abs(error.X)>deadX+1 and math.abs(error.X)>math.abs(previous.X)*.7
  local flipY=error.Y*previous.Y<0 and math.abs(error.Y)>deadY+1 and math.abs(error.Y)>math.abs(previous.Y)*.7
  if flipX or flipY then gameAim.stability=math.max(.25,gameAim.stability*.7)
  else gameAim.stability=math.min(1,gameAim.stability+.005) end
 end
 gameAim.previousError=error
 local rate=config.Tracking=="Direct" and gameRates[config.GameSpeed] or config.Smooth
 local alpha=(1-math.exp(-rate*elapsed))*gameAim.stability
 local advanceLimit=math.pi*elapsed
 local advanceX=math.clamp(gameAim.advanceX,-advanceLimit,advanceLimit)
 local advanceY=math.clamp(gameAim.advanceY,-advanceLimit,advanceLimit)
 gameAim.advanceX=0; gameAim.advanceY=0
 local x=gameAim.responseX and (yaw*alpha/1.25+advanceX)/gameAim.responseX or error.X*.08*elapsed*60
 local y=gameAim.responseY and (pitch*alpha/1.25+advanceY)/gameAim.responseY or error.Y*.08*elapsed*60
 if insideX then x=gameAim.responseX and advanceX/gameAim.responseX or 0 end
 if insideY then y=gameAim.responseY and advanceY/gameAim.responseY or 0 end
 local limit=math.min(48,960*elapsed)
 x=math.clamp(x,-limit,limit); y=math.clamp(y,-limit,limit)
 if relativeInput then
  local accumulatedX=math.clamp(x+gameAim.carryX,-limit,limit)
  local accumulatedY=math.clamp(y+gameAim.carryY,-limit,limit)
  local integerLimit=math.floor(limit)
  x=math.clamp(math.round(accumulatedX),-integerLimit,integerLimit)
  y=math.clamp(math.round(accumulatedY),-integerLimit,integerLimit)
  gameAim.carryX=accumulatedX-x; gameAim.carryY=accumulatedY-y
 end
 if x==0 and y==0 then return end
 local ok,failure=pcall(function()
  if relativeInput then relativeInput(x,y) else virtualInput:SendMouseDelta(Vector2.new(x,y)) end
 end)
 if not ok then
  gameInputError="Entree souris indisponible : "..string.sub(tostring(failure),1,90)
  warn("R1 / visee Jeu : "..tostring(failure))
  resetGameAim(); gameAimMessage=gameInputError; return
 end
 if not gameAim.watch then gameAim.watch=rotation; gameAim.watchClock=0 end
end
local function planAim(dt)
 if stopped then return end
 updateLocalCharacter()
 local camera=workspace.CurrentCamera
 aiming=aimRequested()
 if not camera or not aiming or not localHumanoid or localHumanoid.Health<=0
  or not localRoot or not localRoot:IsDescendantOf(workspace) then
  locked=nil; aimClock=AIM_INTERVAL; aimBlocked=false; blockedSince=nil
  releaseCamera(); return
 end
 if config.Driver=="Jeu" then
  local ready=gameAimReady()
  if not ready then locked=nil; aimClock=AIM_INTERVAL; releaseCamera(); return end
 end
 aimClock+=dt
 -- Liberer une cible morte, hors portee ou retiree sans attendre le prochain scan.
 if locked and not valid(locked) then locked=nil; aimClock=AIM_INTERVAL end
 if aimClock>=AIM_INTERVAL then aimClock=0; acquire(camera) end
 if not valid(locked) then locked=nil; releaseCamera(); return end
 if config.Driver=="Jeu" then releaseCamera(); return end
 local control=ensureCamera(camera)
 local pivot=characterPivot()
 local origin=control.centered and pivot or camera.CFrame.Position
 local targetPosition=locked.aimPart.Position
 local desired=aimRotation(origin,targetPosition,lastAimRotation or camera.CFrame.Rotation)
 if not desired then releaseCamera(); return end
 if lastAimRecord~=locked then lastAimRotation=camera.CFrame.Rotation; lastAimRecord=locked end
 if not aimBlocked then
  if config.Tracking=="Direct" then lastAimRotation=desired
  else lastAimRotation=lastAimRotation:Lerp(desired,1-math.exp(-config.Smooth*math.max(dt,0))) end
 end
 local position=control.centered and collisionSafe(camera,pivot,pivot-lastAimRotation.LookVector*config.AimDistance) or origin
 aimPlan=aimPlan or {}
 aimPlan.camera=camera; aimPlan.control=control; aimPlan.record=locked
 aimPlan.frame=CFrame.new(position)*lastAimRotation
 aimPlan.focus=control.centered and CFrame.new(pivot) or camera.Focus
 aimPlan.target=targetPosition
 camera.CFrame=aimPlan.frame
 if control.centered then camera.Focus=aimPlan.focus end
end
