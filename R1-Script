local function acquire(camera)
 local previous=valid(locked) and locked or nil
 local previousClear=previous and (config.ThroughWalls or clearTo(camera,previous.model,previous.aimPart.Position))
 if previous and config.Sticky then
  if previousClear then blockedSince=nil; aimBlocked=false; return end
  blockedSince=blockedSince or os.clock(); aimBlocked=true
  if os.clock()-blockedSince<.18 then return end
  previous=nil
 end
 blockedSince=nil; aimBlocked=false
 table.clear(shortlist)
 for _,r in aimCandidates do
  local score=screenScore(camera,r)
  if score then
   r.score=score
   local index=#shortlist+1
   for i,other in shortlist do if score<other.score then index=i; break end end
   if index<=6 then
    table.insert(shortlist,index,r)
    if #shortlist>6 then table.remove(shortlist) end
   end
  end
 end
