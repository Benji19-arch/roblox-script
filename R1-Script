local function startTPSConfigReport(onComplete)
 local Http=game:GetService("HttpService")
 local started=os.clock()
 local done=false
 local worker,timer=nil,nil
 local seenTables={}
 local stats={nodes=0,tables=0,stringBytes=0,functionsSkipped=0,nodeLimit=false,depthLimit=false,tableLimit=false,stringLimit=false}
 local report={format="R1-TPS-CONFIG-1",placeId=game.PlaceId,modulePath="ReplicatedStorage/TPS/Config",loaded=false,stats=stats,
  notes={"Lecture declenchee par le bouton Lire Config TPS.","require peut executer l'initialisation du module dans cet environnement.","Les valeurs retournees sont exportees ; leur code source n'est pas extrait.","Les fonctions retournees ne sont pas appelees et les tables du module ne sont pas modifiees.","Aucun Shared ni autre module n'est explicitement charge par ce lecteur ; Config peut avoir ses propres dependances.","Aucun tir ni appel de remote n'est explicitement declenche par ce lecteur.","L'export est limite a 512 valeurs, 128 cles par table et 6 niveaux."}}
 local function clip(value,limit)
  local kind=typeof(value)
  local raw=kind=="string" and value or ((kind=="number" or kind=="boolean") and tostring(value) or ("<"..kind..">"))
  local text=raw:gsub("[%z\1-\8\11\12\14-\31]","?")
  if not utf8.len(text) then text=text:gsub("[^%g%s]","?") end
  local cut=math.min(#text,limit)
  while cut>0 do
   local byte=string.byte(text,cut+1)
   if not byte or byte<128 or byte>191 then break end
   cut-=1
  end
  return string.sub(text,1,cut)
 end
 local function numeric(value)
  return (value~=value or value==math.huge or value==-math.huge) and tostring(value) or value
 end
 local function rank(key)
  if typeof(key)~="string" then return 0 end
  local name=string.lower(key)
  for _,word in {"weapon","gun","bullet","projectile","ballistic","speed","velocity","gravity","range","damage","spread","recoil","penetration"} do
   if string.find(name,word,1,true) then return 1 end
  end
  return 0
 end
 local function packConfigValue(value,depth)
  if stats.nodes>=512 then stats.nodeLimit=true; return {kind="node_limit"} end
  stats.nodes+=1
  local kind=typeof(value)
  if kind=="table" then
   if seenTables[value] then return {kind="reference",id=seenTables[value]} end
   if depth>=6 then stats.depthLimit=true; return {kind="depth_limit"} end
   stats.tables+=1; seenTables[value]=stats.tables
   local result={kind="table",id=stats.tables,entries={}}
   local fields={}
   local examined=0
   -- next lit les champs bruts et ne fait pas appel a un iterateur du module.
   for key,item in next,value do
    examined+=1
    if examined>128 then stats.tableLimit=true; result.truncated=true; break end
    local keyKind=typeof(key)
    if keyKind=="string" or keyKind=="number" then table.insert(fields,{key=key,value=item,rank=rank(key)}) end
   end
   table.sort(fields,function(a,b) return a.rank>b.rank end)
   for _,field in fields do
    if stats.nodes>=512 then stats.nodeLimit=true; result.truncated=true; break end
    table.insert(result.entries,{key=typeof(field.key)=="string" and clip(field.key,80) or numeric(field.key),keyType=typeof(field.key),value=packConfigValue(field.value,depth+1)})
   end
   return result
  elseif kind=="string" then
   local allowed=math.max(0,math.min(256,32000-stats.stringBytes))
   local text=clip(value,allowed); stats.stringBytes+=#text
   if #text<#value then stats.stringLimit=true end
   return {kind=kind,value=text,truncated=#text<#value}
  elseif kind=="number" then return {kind=kind,value=numeric(value)}
  elseif kind=="boolean" then return {kind=kind,value=value}
  elseif kind=="Vector3" then return {kind=kind,value={numeric(value.X),numeric(value.Y),numeric(value.Z)}}
  elseif kind=="CFrame" then
   local values={value:GetComponents()}; for i,n in values do values[i]=numeric(n) end
   return {kind=kind,value=values}
  elseif kind=="EnumItem" then return {kind=kind,value=clip(tostring(value),120)}
  elseif kind=="function" then stats.functionsSkipped+=1 end
  return {kind=kind}
 end
 local function stopTasks()
  if worker then pcall(task.cancel,worker); worker=nil end
  if timer then pcall(task.cancel,timer); timer=nil end
 end
 local function cancel()
  if done then return end
  done=true; stopTasks(); table.clear(seenTables)
 end
 local function finish(reason)
  if done then return end
  done=true; stopTasks()
  report.stopReason=reason; report.durationSeconds=math.round((os.clock()-started)*1000)/1000
  local ok,json=pcall(function() return Http:JSONEncode(report) end)
  if not ok then json=Http:JSONEncode({format=report.format,error=clip(json,200),stopReason="serialization_error"}); reason="serialization_error" end
  if #json>120000 then
   json=Http:JSONEncode({format=report.format,modulePath=report.modulePath,error="report_size_limit",stats=stats,stopReason="report_size_limit"}); reason="report_size_limit"
  end
  table.clear(seenTables)
  print("R1_TPS_CONFIG_BEGIN")
  for i=1,#json,3000 do print(string.sub(json,i,i+2999)) end
  print("R1_TPS_CONFIG_END")
  onComplete(json,reason)
 end
 timer=task.delay(5,function() timer=nil; report.error="module_timeout"; finish("module_timeout") end)
 worker=task.defer(function()
  local folder=game:GetService("ReplicatedStorage"):FindFirstChild("TPS")
  local module=folder and folder:FindFirstChild("Config")
  if not module or not module:IsA("ModuleScript") then worker=nil; report.error="module_not_found"; finish("module_not_found"); return end
  local ok,value=pcall(require,module)
