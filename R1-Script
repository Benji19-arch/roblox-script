-- La couleur ESP est independante du filtre d'obstacles de la visee.
local visibleColor=Color3.fromRGB(65,235,120)
local hiddenColor=Color3.fromRGB(255,65,80)
local sampleNames={"Head","UpperTorso","Torso","HumanoidRootPart","LeftHand","RightHand","LeftFoot","RightFoot","Left Arm","Right Arm","Left Leg","Right Leg"}
local function pointVisible(camera,model,part,character)
 local point,onScreen=camera:WorldToViewportPoint(part.Position)
 if not onScreen or point.Z<=0 then return false end
 local origin=camera.CFrame.Position
 local direction=part.Position-origin
 if direction.Magnitude<0.001 then return true end
 local ignored=character and {character} or {}
 local check=RaycastParams.new()
 check.FilterType=Enum.RaycastFilterType.Exclude
 check.IgnoreWater=true
 -- Ignore uniquement les pieces presque totalement transparentes.
 for _=1,8 do
  check.FilterDescendantsInstances=ignored
  local hit=workspace:Raycast(origin,direction,check)
  if not hit or hit.Instance:IsDescendantOf(model) then return true end
  local obstacle=hit.Instance
  if obstacle:IsA("BasePart") and obstacle.Transparency>=0.95 then
   table.insert(ignored,obstacle)
  else return false end
 end
 return false
end
local function characterVisible(camera,model,character,fallback)
 for _,name in sampleNames do
  local part=model:FindFirstChild(name)
  if part and part:IsA("BasePart") and pointVisible(camera,model,part,character) then return true end
 end
 return fallback~=nil and pointVisible(camera,model,fallback,character)
end
-- Squelette R15 : articulations de rig, avec repli sur le centre des pieces.
local r15Bones={
 {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
 {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
 {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
 {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
 {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
}
local function bodyPart(model,name)
 local p=model:FindFirstChild(name)
 return p and p:IsA("BasePart") and p or nil
end
local function jointPosition(part,attachmentName)
 local attachment=part:FindFirstChild(attachmentName)
 return attachment and attachment:IsA("Attachment") and attachment.WorldPosition or part.Position
end
local r15Points={
 Head="NeckRigAttachment",UpperTorso="NeckRigAttachment",LowerTorso="WaistRigAttachment",
 LeftUpperArm="LeftShoulderRigAttachment",LeftLowerArm="LeftElbowRigAttachment",LeftHand="LeftWristRigAttachment",
 RightUpperArm="RightShoulderRigAttachment",RightLowerArm="RightElbowRigAttachment",RightHand="RightWristRigAttachment",
 LeftUpperLeg="LeftHipRigAttachment",LeftLowerLeg="LeftKneeRigAttachment",LeftFoot="LeftAnkleRigAttachment",
 RightUpperLeg="RightHipRigAttachment",RightLowerLeg="RightKneeRigAttachment",RightFoot="RightAnkleRigAttachment",
}
local function updateSkeleton(camera,model,r)
 local enabled=r.espVisible and config.Skeleton
 r.skeleton.Visible=enabled
 if not enabled then return end
 local segments={}
 if bodyPart(model,"UpperTorso") then
  for _,pair in r15Bones do
   local a,b=bodyPart(model,pair[1]),bodyPart(model,pair[2])
   if a and b then
    local start=pair[1]=="Head" and a.Position or jointPosition(a,r15Points[pair[1]])
    local finish=jointPosition(b,r15Points[pair[2]])
    table.insert(segments,{start,finish})
   end
  end
 else
  -- R6 : points d'epaules et de hanches adaptes a la taille du torse.
  local torso=bodyPart(model,"Torso")
  if torso then
   local function offset(x,y,z) return torso.CFrame:PointToWorldSpace(Vector3.new(x*torso.Size.X,y*torso.Size.Y,z*torso.Size.Z)) end
   local top,bottom=offset(0,.4,0),offset(0,-.4,0)
   table.insert(segments,{top,bottom})
   local head=bodyPart(model,"Head")
   if head then table.insert(segments,{head.Position,top}) end
   for _,limb in {{"Left Arm",-.5,.4,top},{"Right Arm",.5,.4,top},{"Left Leg",-.25,-.4,bottom},{"Right Leg",.25,-.4,bottom}} do
    local part=bodyPart(model,limb[1])
    if part then
     local joint=offset(limb[2],limb[3],0)
     table.insert(segments,{limb[4],joint})
     table.insert(segments,{joint,part.CFrame:PointToWorldSpace(Vector3.new(0,-part.Size.Y*.45,0))})
    end
   end
  end
 end
 for i,line in r.bones do
  local segment=segments[i]
  line.Visible=false
  if segment then
   local a,screenA=camera:WorldToViewportPoint(segment[1])
   local b,screenB=camera:WorldToViewportPoint(segment[2])
   if screenA and screenB and a.Z>0 and b.Z>0 then
    local first,second=Vector2.new(a.X,a.Y),Vector2.new(b.X,b.Y)
    local delta=second-first
    if delta.Magnitude>.5 then
     local midpoint=(first+second)/2
     line.Position=UDim2.fromOffset(midpoint.X,midpoint.Y)
     line.Size=UDim2.fromOffset(delta.Magnitude,2)
     line.Rotation=math.deg(math.atan2(delta.Y,delta.X))
     line.BackgroundColor3=r.espColor
     line.Visible=true
    end
   end
  end
 end
end
local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude
RunService:BindToRenderStep(binding,Enum.RenderPriority.Camera.Value+1,function(dt)
 local camera=workspace.CurrentCamera; if not camera then return end
 local viewport=camera.ViewportSize
 scale.Scale=math.max(.1,math.min(1,(viewport.X-36)/500,(viewport.Y-82)/470))
 circle.Size=UDim2.fromOffset(config.Fov*2,config.Fov*2)
 circle.Position=UDim2.fromOffset(viewport.X/2,viewport.Y/2)
 circle.Visible=config.Circle and config.Aim
 local character=player.Character
 local root=character and character:FindFirstChild("HumanoidRootPart")
 local humanoid=character and character:FindFirstChildOfClass("Humanoid")
 local canAim=aiming and config.Aim and humanoid and humanoid.Health>0 and not Input:GetFocusedTextBox()
 params.FilterDescendantsInstances=character and {character} or {}
 local bestModel,bestPart,best,stickyPart=nil,nil,config.Fov,nil
 local count=0
 for model,r in records do
  if not model:IsDescendantOf(workspace) or r.humanoid.Parent~=model then remove(model); continue end
  local owner=Players:GetPlayerFromCharacter(model)
  local bot=owner==nil
  local part=model:FindFirstChild(config.Part) or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head") or model.PrimaryPart
  if part and not part:IsA("BasePart") then part=nil end
  local allied=false
  if config.TeamCheck then
   if owner then allied=not player.Neutral and not owner.Neutral and player.Team~=nil and player.Team==owner.Team
   else allied=model:GetAttribute("Friendly")==true or (not player.Neutral and player.Team~=nil and model:GetAttribute("TeamName")==player.Team.Name) end
  end
  local distance=part and root and (part.Position-root.Position).Magnitude or math.huge
  local eligible=model~=character and owner~=player and (bot and config.Bots or not bot and config.TargetPlayers) and not allied and r.humanoid.Health>0 and part~=nil and distance<=config.Range
  local visible=config.ESP and eligible
  if visible and os.clock()-r.lastCheck>=0.1 then
   r.inSight=characterVisible(camera,model,character,part)
   r.lastCheck=os.clock()
  elseif not visible then r.lastCheck=0 end
  local color=r.inSight and visibleColor or hiddenColor
  r.highlight.Enabled=visible and config.Outline
  r.highlight.FillColor=color; r.highlight.OutlineColor=color
  r.highlight.OutlineTransparency=config.Outline and 0 or 1
  r.highlight.FillTransparency=1 -- Contour de la silhouette uniquement.
  r.text.TextColor3=color
  r.espVisible=visible; r.espColor=color
  r.info.Enabled=visible and (config.Names or config.Health or config.Distance); r.info.Adornee=part
  if visible then
   local lines={}
   if config.Names then
    table.insert(lines,bot and "[PNJ] "..model.Name or "[JOUEUR] "..owner.DisplayName)
    table.insert(lines,r.inSight and "VISIBLE" or "CACHE")
   end
   if config.Health then table.insert(lines,string.format("Vie : %.0f / %.0f",r.humanoid.Health,r.humanoid.MaxHealth)) end
   if config.Distance then table.insert(lines,string.format("%.0f studs",distance)) end
   r.text.Text=table.concat(lines,"\n")
  end
  if eligible then count+=1 end
  if canAim and eligible then
   local point,onScreen=camera:WorldToViewportPoint(part.Position)
   local score=(Vector2.new(point.X,point.Y)-viewport/2).Magnitude
   if onScreen and point.Z>0 and score<=config.Fov and (score<=best or model==locked) then
    local hit
    if config.WallCheck then hit=workspace:Raycast(camera.CFrame.Position,part.Position-camera.CFrame.Position,params) end
    if not hit or hit.Instance:IsDescendantOf(model) then
     if model==locked then stickyPart=part end
     if score<=best then bestModel,bestPart,best=model,part,score end
    end
   end
  end
 end
 if canAim and config.Sticky and stickyPart then bestModel,bestPart=locked,stickyPart end
 locked=canAim and bestModel or nil
 if bestPart and (bestPart.Position-camera.CFrame.Position).Magnitude>.001 then
  camera.CFrame=camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position,bestPart.Position),1-math.exp(-config.Smooth*dt))
 end
 -- Projection apres le mouvement de camera pour suivre exactement les animations.
 for model,r in records do updateSkeleton(camera,model,r) end
 stroke.Color=locked and Color3.fromRGB(255,184,85) or accent
 status.Text=locked and "Cible : "..locked.Name or string.format("%d cibles / %s",count,config.Aim and (aiming and "Recherche..." or "Maintiens le clic droit") or "Visee desactivee")
end)
local function cleanup()
 if stopped then return end
 stopped=true; RunService:UnbindFromRenderStep(binding)
 for _,c in connections do c:Disconnect() end
 for model in records do remove(model) end
 gui:Destroy()
end
connect(shutdown.Event,cleanup)
connect(script.Destroying,cleanup)
connect(gui.Destroying,cleanup)
